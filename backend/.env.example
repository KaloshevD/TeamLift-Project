PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/slots
# Optional: free key from https://aistudio.google.com/apikey
# Without it, a template confirmation message is used instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Optional: Google Calendar (hide slots that clash with your events) ---
# Create an OAuth "Web application" client in Google Cloud Console (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
FRONTEND_URL=http://localhost:5173
# Time zone of your slots and calendar (IANA name). Defaults to the server's zone.
APP_TIMEZONE=
